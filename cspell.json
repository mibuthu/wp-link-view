// cSpell Settings
{
    // Version of the setting file
    "version": "0.2",
    // Active spelling language
    "language": "en",
    // Ignored paths and files
    "ignorePaths": [
        "cspell.json",
        "*.code-workspace",
        "composer*",
        "assets/**",
        "vendor/**",
        "** copy.*",
        "src/languages/**",
        "src/includes/js/**",
        "*.svg"
    ],
    // List of words to be always considered correct
    "words": [
        "atts",
        "blogroll",
        "kses",
        "linkview",
        "mibuthu",
        "phan",
        "phpcs",
        "rels",
        "transifex",
        "unslash",
        "WPINC",
    ]
}